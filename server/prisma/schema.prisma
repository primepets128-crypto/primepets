generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  firebaseId String? @unique
  email     String?  @unique
  phone     String?  @unique
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  brand       String
  price       Float
  mrp         Float
  rating      Float
  reviews     Int
  img         String
  images      String?
  tag         String?
  badge       String?
  category    String
  petType     String
  description String?
}

model Category {
  id    Int    @id @default(autoincrement())
  label String
  emoji String
  img   String
  bg    String
}

model Deal {
  id     Int    @id @default(autoincrement())
  title  String
  sub    String
  badge  String
  tag    String
  img    String
  grad   String
  bg     String
  border String
  save   String
}

model Slide {
  id       Int     @id @default(autoincrement())
  gradient String
  tag      String
  badge    String
  title    String
  subtitle String
  cta      String
  dog      String
  cat      String
  heroImage String?
}

model FrontendSetting {
  id                  Int    @id @default(autoincrement())
  storeName           String
  tagline             String
  logoChar            String
  footerDescription   String
  facebookUrl         String
  instagramUrl        String
  youtubeUrl          String
  whatsappNumber      String
  logoBase64          String?
  razorpayKeyId       String?
  whatsappOrderNumber String?
  siteAudioUrl        String?
  contactEmail        String?
  contactPhone        String?
}

model Banner {
  id       Int     @id @default(autoincrement())
  mediaUrl String
  link     String?
}

model Order {
  id            Int      @id @default(autoincrement())
  visitorId     String?
  customerName  String
  customerPhone String
  customerAddress String
  items         String   // JSON string of cart items
  total         Float
  paymentMethod String   // "COD" | "ONLINE"
  paymentStatus String   @default("PENDING") // PENDING | PAID | FAILED
  status        String   @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  razorpayOrderId String?
  razorpayPaymentId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteVisit {
  id        Int      @id @default(autoincrement())
  visitorId String
  page      String
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String
  timestamp DateTime @default(now())
  ip        String?
  userAgent String?
}

model Visitor {
  id            String   @id @default(uuid())
  visitorId     String   @unique
  name          String?
  phone         String?
  fcmToken      String?
  device        String?
  browser       String?
  os            String?
  ip            String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ShippingSetting {
  id           Int      @id @default(autoincrement())
  provider     String   @unique @default("DTDC")
  username     String?
  password     String?
  apiKey       String?
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}
